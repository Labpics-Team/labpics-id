{
  "name": "labpics-id",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Labpics ID — self-owned identity platform: OIDC/OAuth 2.1, organizations, RBAC, MFA, admin & login UI",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.9.0"
  },
  "scripts": {
    "typecheck": "bun run --filter './apps/*' typecheck && bun run --filter './packages/*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "bun run --filter './apps/*' build && bun run --filter './packages/*' build",
    "test": "bun test --timeout 120000",
    "security:proof": "bun scripts/security-proof/run-security-proof.ts",
    "gate:ch02": "bun scripts/security-proof/chapter-gate.ts",
    "check:domain-gate": "bun run --cwd packages/domain check:domain-gate",
    "db:generate": "bun --cwd packages/db run db:generate",
    "db:migrate": "bun --cwd packages/db run db:migrate",
    "db:push": "bun --cwd packages/db run db:push",
    "dev:api": "bun --cwd apps/api run dev",
    "dev:web": "bun --cwd apps/web run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  }
}
