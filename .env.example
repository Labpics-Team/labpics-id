# ────────────────────────────────────────────────────────────────
# Labpics ID — local development placeholders ONLY.
# Copy to `.env` and replace values for your machine.
# Never commit real secrets; never reuse these values anywhere else.
# ────────────────────────────────────────────────────────────────

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://labpics:labpics-dev-password@localhost:54310/labpics

# API (apps/api)
PORT=3000
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=10000
# Comma-separated list of allowed CORS origins (web dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Better Auth (apps/api) — placeholder secret, rotate before any real deployment
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_PERSISTENCE=memory

# Web (apps/web)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Protocol (apps/protocol) — Node >=22.11 only; Bun is rejected at startup
PROTOCOL_PORT=3002
PROTOCOL_ISSUER=https://id.lab.pics
PROTOCOL_API_BASE_URL=http://localhost:3000
# development: memory + generated; production requires external + supplied JWKS
PROTOCOL_ADAPTER=memory
PROTOCOL_JWKS=generated
# JSON array of workload credentials shared with the API boundary endpoint.
# Placeholder only — deliver real values through the secret boundary.
PROTOCOL_BOUNDARY_CREDENTIALS=[{"id":"protocol-workload","secret":"replace-me-with-a-32-byte-random-secret","operations":["subject.get","session.resolve"]}]
PROTOCOL_BOUNDARY_TIMEOUT_MS=3000
PROTOCOL_BOUNDARY_MAX_RETRIES=2
