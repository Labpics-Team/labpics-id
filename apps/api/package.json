{
  "name": "@labpics/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Labpics ID — Hono on Bun core API: health/readiness, pino, request-id, error envelope, timeout, CORS allowlist, /api/v1, Better Auth behind a port wrapper.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "bun --watch ./src/index.ts",
    "start": "bun ./src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir ./dist --target=bun",
    "test": "bun test --timeout 120000"
  },
  "dependencies": {
    "@labpics/contracts": "0.1.0",
    "@labpics/db": "0.1.0",
    "@labpics/domain": "0.1.0",
    "better-auth": "1.6.28",
    "hono": "4.13.1",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@labpics/testkit": "0.1.0",
    "@types/bun": "1.3.14",
    "@types/pg": "8.21.0",
    "pino-pretty": "13.1.3"
  }
}
