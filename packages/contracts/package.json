{
  "name": "@labpics/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Labpics ID — shared Zod schemas used by both the API and the web app.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./boundary-auth": {
      "types": "./src/boundary-auth.ts",
      "default": "./src/boundary-auth.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir ./dist --target=bun",
    "test": "bun test"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
